+/// `rect` cut down to the part inside `bounds`, possibly empty, at `bounds`'s
+/// origin when it starts before it (patched locally).
+fn clamp_rect(rect: Rect, bounds: &Rect) -> Rect {
+  let x0 = rect.p.x.max(bounds.p.x);
+  let y0 = rect.p.y.max(bounds.p.y);
+  let x1 = rect.p.x.saturating_add(rect.d.w).min(bounds.p.x + bounds.d.w).max(x0);
+  let y1 = rect.p.y.saturating_add(rect.d.h).min(bounds.p.y + bounds.d.h).max(y0);
+  Rect::new(Point::new(x0, y0), Dim2::new(x1 - x0, y1 - y0))
+}
