+  let band_rows = match ljpeg.restart_interval {
+    0 => height,
+    interval if interval >= ljpeg.sof.width * height => height,
+    interval if interval % ljpeg.sof.width == 0 => interval / ljpeg.sof.width,
+    interval => {
+      return Err(format!(
+        "ljpeg: restart interval {} is not a whole number of {}-pixel rows",
+        interval, ljpeg.sof.width
+      ));
+    }
+  };
+
+  let mut buffer = ljpeg.buffer;
+  for first_row in (0..height).step_by(band_rows) {
+    let last_row = (first_row + band_rows).min(height);
+    let band = if last_row < height {
+      let marker = find_restart_marker(buffer).ok_or_else(|| format!("ljpeg: missing restart marker before row {}", last_row))?;
+      let band = &buffer[..marker];
+      buffer = &buffer[marker + 2..];
+      band
+    } else {
+      buffer
+    };
+    decode_ljpeg_rows(ljpeg, band, out, x, stripwidth, width, first_row, last_row)?;
+  }
+  Ok(())
+}
