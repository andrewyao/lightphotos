+/// Offset of the next RSTn marker. Entropy-coded data byte-stuffs every
+/// 0xFF with 0x00, so 0xFF followed by 0xD0..=0xD7 can only be a marker.
+fn find_restart_marker(buffer: &[u8]) -> Option<usize> {
+  buffer.windows(2).position(|w| w[0] == 0xFF && (0xD0..=0xD7).contains(&w[1]))
+}
